        <name>Математика. Учебник для 5 класса</name>
        <vendor>Издательство «Пример»</vendor>
        <country>Россия</country>
        <vendorCode>BK-001</vendorCode>
        <units>796</units>
        <categoryId>edu-books</categoryId>
